              "sampleData": {},
              "sourceCode": {
                "code": "// input: current_row (object)\nconst row = input.current_row || {};\nconst dueRaw = row.DueDate || row.dueDate || \"\";\nconst status = (row.Status || row.status || \"\").toString().trim().toLowerCase();\nconst lastReminder = row.LastReminderDate || row.lastReminderDate || \"\";\n\nfunction parseDate(s) {\n  if (!s) return null;\n  const d = new Date(s);\n  if (!isNaN(d)) return d;\n  const parts = s.split(/[\\/\\-\\.]/).map(p=>p.trim());\n  if (parts.length===3) {\n    if (parts[0].length===4) return new Date(`${parts[0]}-${parts[1]}-${parts[2]}`);\n    return new Date(`${parts[2]}-${parts[0]}-${parts[1]}`);\n  }\n  return null;\n}\n\nconst dueDate = parseDate(dueRaw);\nconst now = new Date();\nconst today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\n\nlet needs_remind = false;\nlet reason = \"\";\n\nif (!dueDate) {\n  reason = \"no_due_date\";\n} else if (status === \"paid\") {\n  reason = \"already_paid\";\n} else {\n  const dueOnly = new Date(Date.UTC(dueDate.getUTCFullYear(), dueDate.getUTCMonth(), dueDate.getUTCDate()));\n  if (dueOnly < today) {\n    if (lastReminder) {\n      const lr = parseDate(lastReminder);\n      if (lr) {\n        const lrOnly = new Date(Date.UTC(lr.getUTCFullYear(), lr.getUTCMonth(), lr.getUTCDate()));\n        if (lrOnly.getTime() === today.getTime()) {\n          needs_remind = false; reason = \"already_reminded_today\";\n        } else { needs_remind = true; reason = \"overdue_not_reminded_today\"; }\n      } else { needs_remind = true; reason = \"overdue_lastReminder_bad_format\"; }\n    } else { needs_remind = true; reason = \"overdue_never_reminded\"; }\n  } else reason = \"not_overdue\";\n}\n\nif (status !== \"unpaid\" && needs_remind) { needs_remind = false; reason = \"status_not_unpaid\"; }\n\nreturn { needs_remind, reason, dueDateParsed: dueDate ? dueDate.toISOString().slice(0,10) : null };",
                "packageJson": "{}"
