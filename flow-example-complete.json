{
  "type": "IMPORT_FLOW",
  "request": {
    "displayName": "Example Flow with Webhook and HTTP Action",
    "schemaVersion": null,
    "trigger": {
      "type": "PIECE_TRIGGER",
      "name": "trigger_webhook_1",
      "valid": true,
      "displayName": "Webhook Trigger",
      "settings": {
        "pieceName": "@activepieces/piece-webhook",
        "pieceVersion": "1.0.0",
        "triggerName": "webhook",
        "input": {},
        "propertySettings": {}
      },
      "nextAction": {
