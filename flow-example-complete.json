          "settings": {
            "sourceCode": {
              "packageJson": "{\"name\":\"process-response\",\"version\":\"1.0.0\"}",
              "code": "export const processResponse = async (response) => {\n  return {\n    processed: true,\n    data: response.body\n  }\n}"
            },
            "input": {
              "response": "{{action_http_1.body}}"
            },
            "propertySettings": {}
          }
        }
      }
