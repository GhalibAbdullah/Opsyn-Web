## Staging environment (Postgres example)  untracked, safe to edit per environment
# Core
AP_ENVIRONMENT=staging
AP_FRONTEND_URL=https://your-staging-frontend.example.com
AP_WEBHOOK_URL=https://your-staging-api.example.com
AP_LOG_LEVEL=info
AP_LOG_PRETTY=true
AP_TELEMETRY_ENABLED=false
AP_ENRICH_ERROR_CONTEXT=true

# Database (Postgres)
AP_DB_TYPE=POSTGRES
AP_POSTGRES_HOST=your-db-host
AP_POSTGRES_PORT=5432
AP_POSTGRES_DATABASE=your-db-name
AP_POSTGRES_USERNAME=your-db-user
AP_POSTGRES_PASSWORD=your-db-password

# Queue (Redis recommended for staging)
AP_QUEUE_MODE=REDIS
AP_REDIS_HOST=your-redis-host
AP_REDIS_PORT=6379
AP_REDIS_PASSWORD=

# Pieces
AP_PIECES_SOURCE=FILE
AP_DEV_PIECES=http,google-sheets,store,openai,agent,hunter,apollo,text-ai,webhook
AP_PIECES_SYNC_MODE=NONE
AP_TRIGGER_DEFAULT_POLL_INTERVAL=1
AP_WEBHOOK_TIMEOUT_SECONDS=30

# Optional: API key for internal tasks
AP_API_KEY=api-key

# Paths (keep defaults or set absolute paths if desired)
AP_CACHE_PATH=./dev/cache
AP_CONFIG_PATH=./dev/config
