AP_API_KEY="api-key"
AP_CACHE_PATH="./dev/cache"
AP_CHATBOT_ENABLED=true
AP_CONFIG_PATH="./dev/config"
AP_DB_TYPE=SQLITE3
AP_DEV_PIECES="ask-ai,delay,code,schedule,slack,gmail,google-sheets,google-drive,webhook,github,discord,notion,airtable,trello,stripe,hubspot,typeform,todoist,http,openai,amazon-s3,delay,rss,calendly,jira,linear,zendesk,intercom,clickup,asana,monday,dropbox,box,microsoft-onedrive,mailchimp,wordpress,twitter,pagerduty,google-forms,telegram-bot"
AP_ENRICH_ERROR_CONTEXT=true
AP_ENVIRONMENT=prod
AP_FRONTEND_URL="http://localhost:4200"
AP_LOG_LEVEL=debug
AP_LOG_PRETTY=true
AP_PIECES_SOURCE='FILE'
AP_QUEUE_MODE=MEMORY
AP_TELEMETRY_ENABLED=false
AP_TRIGGER_DEFAULT_POLL_INTERVAL=1
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_PIECES_SYNC_MODE=NONE
AP_WEBHOOK_URL="http://localhost:3000"

# Resend SMTP (password reset, invitations, etc.) - one-time config
AP_SMTP_HOST=smtp.resend.com
AP_SMTP_PORT=465
AP_SMTP_USERNAME=resend
AP_SMTP_PASSWORD=your_resend_api_key_here
AP_SMTP_SENDER_EMAIL=onboarding@resend.dev
